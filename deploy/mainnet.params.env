# Parameters for script/DeployMainnet.s.sol and script/VerifyMainnet.s.sol, filled 2026-11-09 after the pollers ended.
# Nothing secret belongs here: no keys, no API keys. The deployer key is the keystore `speedrun`, typed at runtime.
# Every value says what KIND of evidence it rests on: MEASURED, INFERRED, CHOSEN. None is a fitted percentile.

# --- weekly window
ORACLE_OPEN_OFFSET=3600             # MEASURED once: all four polled feeds printed Mon 2026-11-09 01:00:33..01:00:46 UTC (Sun 20:00 ET, winter time). Moves one hour earlier when US daylight time starts (2027-03-14), well after CALENDAR_CONFIRMED_UNTIL.
ORACLE_CLOSE_OFFSET=435600          # INFERRED, not measured: Fri 20:00 ET = Sat 01:00 UTC (5 days + 1 h). Quiet feeds cannot show the close; the last Friday prints (19:58..21:39 UTC) are consistent with it.

# --- feed behaviour
ORACLE_HEARTBEAT=86400              # fact: Chainlink Coinbase equity feeds, 24 h
ORACLE_HEARTBEAT_MARGIN=3600        # CHOSEN: one hour of tolerance on the heartbeat. Not measured.
ORACLE_COMPARISON_WINDOW=3600       # CHOSEN from 42 prints of GOOGL and TSLA: nearest 24/7 print was a median 2..9 min and at most 79 min from a primary print.

# --- silence threshold, in OPEN seconds, the same for all ten tokens
# CHOSEN, not a percentile. The pollers covered 6 of 12 tokens and one weekend, too little for a defensible per-token
# percentile (AAPL printed 5 times in the whole period). The anchor is one observation: AAPL stayed silent 13.5 h with the
# market open (Mon 01:00 to 14:30 UTC). 14 h is more than the longest normal silence seen. The 24 h heartbeat (+ margin) is the
# hard limit, so this number only decides when to suspect a stale feed, never when to know. Reconfigurable by the recorder
# with setThreshold once weeks of data exist.
THRESHOLD_AAPL=50400
THRESHOLD_AMZN=50400
THRESHOLD_GOOGL=50400
THRESHOLD_META=50400
THRESHOLD_MSFT=50400
THRESHOLD_MSTR=50400
THRESHOLD_NVDA=50400
THRESHOLD_SNDK=50400
THRESHOLD_SPCX=50400
THRESHOLD_TSLA=50400

# --- calendar decisions (US Thanksgiving). DECIDED: declare wide, because a closure cannot be removed or narrowed once added.
# CONFIRMED_UNTIL is 2026-12-24 00:00 UTC on purpose: no later holiday is declared, so the oracle must not claim a calendar it has
# not loaded. The recorder extends it with confirmCalendarUntil when the next closures are added.
CALENDAR_CONFIRMED_UNTIL=1798070400
CLOSURE_COUNT=2
CLOSURE_0_START=1795651200          # Thu 2026-11-26 00:00 UTC
CLOSURE_0_END=1795737600            # Fri 2026-11-27 00:00 UTC
CLOSURE_0_KIND=0                    # HOLIDAY
CLOSURE_1_START=1795737600          # Fri 2026-11-27 00:00 UTC
CLOSURE_1_END=1795824000            # Sat 2026-11-28 00:00 UTC
CLOSURE_1_KIND=1                    # EARLY_CLOSE

# --- vault factory
MULTIPLIER_WINDOW_SECS=3600         # CHOSEN: warning window before a scheduled multiplier change and settle time after one. The unit of effectiveAt() is unverified live; the value check does not depend on it.
