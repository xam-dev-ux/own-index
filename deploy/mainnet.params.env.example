# Parameters for script/DeployMainnet.s.sol and script/VerifyMainnet.s.sol. Copy to deploy/mainnet.params.env and fill in.
# The scripts refuse any value that is empty, missing, or contains PENDING or DISPOSABLE.
# Nothing secret belongs here: no keys, no API keys. The deployer key is the keystore `speedrun`, typed at runtime.

# --- measured from the weekend data (pollers end Mon 2026-11-09 16:00 UTC): PENDING until then
ORACLE_OPEN_OFFSET=PENDING          # seconds after Monday 00:00 UTC when the weekly window opens
ORACLE_CLOSE_OFFSET=PENDING         # seconds after Monday 00:00 UTC when it closes (Friday evening)
ORACLE_COMPARISON_WINDOW=PENDING    # seconds; max distance between primary and secondary prints to compare
ORACLE_HEARTBEAT_MARGIN=PENDING     # seconds of tolerance on the 24h heartbeat
THRESHOLD_AAPL=PENDING              # in-session threshold in OPEN seconds, from p99 of inter-print gaps
THRESHOLD_AMZN=PENDING
THRESHOLD_GOOGL=PENDING
THRESHOLD_META=PENDING
THRESHOLD_MSFT=PENDING
THRESHOLD_MSTR=PENDING
THRESHOLD_NVDA=PENDING
THRESHOLD_SNDK=PENDING
THRESHOLD_SPCX=PENDING
THRESHOLD_TSLA=PENDING
THRESHOLD_INTC=PENDING
THRESHOLD_CRCL=PENDING

# --- known facts of the feeds
ORACLE_HEARTBEAT=86400              # Chainlink Coinbase equity feeds, 24 h

# --- calendar decisions (US Thanksgiving): PENDING until how the 24/5 feeds treat these days is decided
CALENDAR_CONFIRMED_UNTIL=PENDING    # unix time; must be at least 2026-11-28 00:00 UTC (1795824000)
CLOSURE_COUNT=PENDING               # intervals below, in time order, non overlapping
CLOSURE_0_START=PENDING             # must be a HOLIDAY (kind 0) covering Thu 2026-11-26 17:00 UTC
CLOSURE_0_END=PENDING
CLOSURE_0_KIND=PENDING              # 0 = HOLIDAY, 1 = EARLY_CLOSE
CLOSURE_1_START=PENDING             # must be an EARLY_CLOSE (kind 1) covering Fri 2026-11-27 20:00 UTC
CLOSURE_1_END=PENDING
CLOSURE_1_KIND=PENDING

# --- vault factory
MULTIPLIER_WINDOW_SECS=PENDING      # warning window for a scheduled multiplier change, and settle time after a change
